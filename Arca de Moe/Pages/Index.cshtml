@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div style="text-align:center; padding: 2rem 0 1.5rem;">
    <h1 style="font-size:2rem; font-weight:700; color:var(--color-primary-dk); margin-bottom:.5rem;">
        Bienvenido!!!!
    </h1>
</div>

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:1.25rem; margin-top:1rem;">

    <a asp-page="/Propietarios/Index" style="text-decoration:none;">
        <div class="card-section" style="text-align:center; transition: box-shadow .2s; cursor:pointer;"
             onmouseover="this.style.boxShadow='0 4px 16px rgba(74,144,164,.25)'"
             onmouseout="this.style.boxShadow='var(--shadow)'">
            <div style="font-size:2.2rem;"></div>
            <div style="font-weight:700; margin-top:.5rem; color:var(--color-primary-dk);">Propietarios</div>
            <div style="font-size:.85rem; color:var(--color-muted); margin-top:.25rem;">Gestionar dueños</div>
        </div>
    </a>

    <a asp-page="/Mascotas/Index" style="text-decoration:none;">
        <div class="card-section" style="text-align:center; transition: box-shadow .2s; cursor:pointer;"
             onmouseover="this.style.boxShadow='0 4px 16px rgba(74,144,164,.25)'"
             onmouseout="this.style.boxShadow='var(--shadow)'">
            <div style="font-size:2.2rem;"></div>
            <div style="font-weight:700; margin-top:.5rem; color:var(--color-primary-dk);">Mascotas</div>
            <div style="font-size:.85rem; color:var(--color-muted); margin-top:.25rem;">Gestionar pacientes</div>
        </div>
    </a>

    <a asp-page="/Veterinarios/Index" style="text-decoration:none;">
        <div class="card-section" style="text-align:center; transition: box-shadow .2s; cursor:pointer;"
             onmouseover="this.style.boxShadow='0 4px 16px rgba(74,144,164,.25)'"
             onmouseout="this.style.boxShadow='var(--shadow)'">
            <div style="font-size:2.2rem;"></div>
            <div style="font-weight:700; margin-top:.5rem; color:var(--color-primary-dk);">Veterinarios</div>
            <div style="font-size:.85rem; color:var(--color-muted); margin-top:.25rem;">Gestionar médicos</div>
        </div>
    </a>

    <a asp-page="/Citas/Index" style="text-decoration:none;">
        <div class="card-section" style="text-align:center; transition: box-shadow .2s; cursor:pointer;"
             onmouseover="this.style.boxShadow='0 4px 16px rgba(74,144,164,.25)'"
             onmouseout="this.style.boxShadow='var(--shadow)'">
            <div style="font-size:2.2rem;"></div>
            <div style="font-weight:700; margin-top:.5rem; color:var(--color-primary-dk);">Citas</div>
            <div style="font-size:.85rem; color:var(--color-muted); margin-top:.25rem;">Gestionar consultas</div>
        </div>
    </a>

</div>
