@page "{id:int}"
@model ArcaDeMoe.Pages.Propietarios.DetailsModel
@{
    ViewData["Title"] = "Detalle del propietario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/propietarios.css" asp-append-version="true" />
}

<div class="page-header">
    <h1 class="propietarios-icon">Detalle del propietario</h1>
    <a asp-page="Index" class="btn-sm-am btn-back">← Volver</a>
</div>

<div class="card-section">
    <div class="detail-grid">
        <div class="detail-item">
            <label>Nombre</label>
            <span>@Model.Propietario.Nombre</span>
        </div>
        <div class="detail-item">
            <label>Apellidos</label>
            <span>@Model.Propietario.Apellidos</span>
        </div>
        <div class="detail-item">
            <label>Teléfono</label>
            <span>@Model.Propietario.Telefono</span>
        </div>
        <div class="detail-item">
            <label>Correo electrónico</label>
            <span>@Model.Propietario.Email</span>
        </div>
        <div class="detail-item">
            <label>Estado</label>
            <span>
                @if (Model.Propietario.Estado)
                {
                    <span class="estado-badge badge-activo">Activo</span>
                }
                else
                {
                    <span class="estado-badge badge-inactivo">Inactivo</span>
                }
            </span>
        </div>
    </div>

    <div class="form-actions" style="margin-top:1.5rem">
        <a asp-page="Edit" asp-route-id="@Model.Propietario.Id" class="btn-sm-am btn-edit">Editar</a>
        <a asp-page="Delete" asp-route-id="@Model.Propietario.Id" class="btn-sm-am btn-delete">Eliminar</a>
    </div>
</div>
