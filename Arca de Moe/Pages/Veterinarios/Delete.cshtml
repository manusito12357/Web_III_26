@page "{id:int}"
@model ArcaDeMoe.Pages.Veterinarios.DeleteModel
@{
    ViewData["Title"] = "Eliminar veterinario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/veterinarios.css" asp-append-version="true" />
}

<div class="page-header">
    <h1 class="veterinarios-icon">Eliminar veterinario</h1>
</div>

<div class="card-section">
    <div class="delete-box">
        <p>¿Estás seguro de que deseas eliminar a este veterinario? Esta acción no se puede deshacer.</p>

        <div class="detail-grid" style="margin-bottom:1.25rem">
            <div class="detail-item">
                <label>Nombre</label>
                <span>@Model.Veterinario.Nombre @Model.Veterinario.Apellidos</span>
            </div>
            <div class="detail-item">
                <label>Especialidad</label>
                <span>@Model.Veterinario.Especialidad</span>
            </div>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Veterinario.Id" />
            <div class="form-actions">
                <button type="submit" class="btn-sm-am btn-delete">Sí, eliminar</button>
                <a asp-page="Index" class="btn-sm-am btn-back">Cancelar</a>
            </div>
        </form>
    </div>
</div>
