@page
@model ArcaDeMoe.Pages.Veterinarios.IndexModel
@{
    ViewData["Title"] = "Veterinarios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/veterinarios.css" asp-append-version="true" />
}

<div class="page-header">
    <h1>Veterinarios</h1>
    <a asp-page="Create" class="btn-primary-am">+ Nuevo veterinario</a>
</div>

<div class="card-section">
    <div class="table-responsive-am">
        <table class="table-arcademoe">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Apellidos</th>
                    <th class="col-especialidad">Especialidad</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Veterinarios)
                {
                    <tr>
                        <td>@v.Id</td>
                        <td>@v.Nombre</td>
                        <td>@v.Apellidos</td>
                        <td>@v.Especialidad</td>
                        <td>@v.Telefono</td>
                        <td>
                            @if (v.Estado)
                            {
                                <span class="estado-badge badge-activo">Activo</span>
                            }
                            else
                            {
                                <span class="estado-badge badge-inactivo">Inactivo</span>
                            }
                        </td>
                        <td>
                            <a asp-page="Details" asp-route-id="@v.Id" class="btn-sm-am btn-details">Ver</a>
                            <a asp-page="Edit"    asp-route-id="@v.Id" class="btn-sm-am btn-edit">Editar</a>
                            <a asp-page="Delete"  asp-route-id="@v.Id" class="btn-sm-am btn-delete">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
