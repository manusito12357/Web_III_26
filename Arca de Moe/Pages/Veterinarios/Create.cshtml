@page
@model ArcaDeMoe.Pages.Veterinarios.CreateModel
@{
    ViewData["Title"] = "Nuevo veterinario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/veterinarios.css" asp-append-version="true" />
}

<div class="page-header">
    <h1 class="veterinarios-icon">Nuevo veterinario</h1>
</div>

<div class="card-section">
    <form method="post" class="form-section">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group-am">
            <label asp-for="Veterinario.Nombre"></label>
            <input asp-for="Veterinario.Nombre" placeholder="Ej: María" />
            <span asp-validation-for="Veterinario.Nombre" class="text-danger"></span>
        </div>

        <div class="form-group-am">
            <label asp-for="Veterinario.Apellidos"></label>
            <input asp-for="Veterinario.Apellidos" placeholder="Ej: Torres Paz" />
            <span asp-validation-for="Veterinario.Apellidos" class="text-danger"></span>
        </div>

        <div class="form-group-am">
            <label asp-for="Veterinario.Especialidad"></label>
            <select asp-for="Veterinario.Especialidad">
                <option value="">-- Seleccionar --</option>
                <option value="General">General</option>
                <option value="Cirugía">Cirugía</option>
                <option value="Dermatología">Dermatología</option>
                <option value="Cardiología">Cardiología</option>
                <option value="Nutrición">Nutrición</option>
            </select>
            <span asp-validation-for="Veterinario.Especialidad" class="text-danger"></span>
        </div>

        <div class="form-group-am">
            <label asp-for="Veterinario.Telefono"></label>
            <input asp-for="Veterinario.Telefono" placeholder="Ej: 555-3001" />
            <span asp-validation-for="Veterinario.Telefono" class="text-danger"></span>
        </div>

        <div class="form-check-am">
            <input asp-for="Veterinario.Estado" type="checkbox" />
            <label asp-for="Veterinario.Estado">Activo</label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary-am">Guardar</button>
            <a asp-page="Index" class="btn-sm-am btn-back">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
