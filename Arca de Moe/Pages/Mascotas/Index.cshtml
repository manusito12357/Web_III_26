@page
@model ArcaDeMoe.Pages.Mascotas.IndexModel
@{
    ViewData["Title"] = "Mascotas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/mascotas.css" asp-append-version="true" />
}

<div class="page-header">
    <h1>Mascotas</h1>
    <a asp-page="Create" class="btn-primary-am">+ Nueva mascota</a>
</div>

<div class="card-section">
    <div class="table-responsive-am">
        <table class="table-arcademoe">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th class="col-especie">Especie</th>
                    <th class="col-raza">Raza</th>
                    <th>Fecha de nacimiento</th>
                    <th>Propietario ID</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Mascotas)
                {
                    <tr>
                        <td>@m.Id</td>
                        <td>@m.Nombre</td>
                        <td>@m.Especie</td>
                        <td>@m.Raza</td>
                        <td>@m.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                        <td>@m.PropietarioId</td>
                        <td>
                            @if (m.Estado)
                            {
                                <span class="estado-badge badge-activo">Activo</span>
                            }
                            else
                            {
                                <span class="estado-badge badge-inactivo">Inactivo</span>
                            }
                        </td>
                        <td>
                            <a asp-page="Details" asp-route-id="@m.Id" class="btn-sm-am btn-details">Ver</a>
                            <a asp-page="Edit"    asp-route-id="@m.Id" class="btn-sm-am btn-edit">Editar</a>
                            <a asp-page="Delete"  asp-route-id="@m.Id" class="btn-sm-am btn-delete">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
