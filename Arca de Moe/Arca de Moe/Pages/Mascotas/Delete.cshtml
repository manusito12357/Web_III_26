@page "{id:int}"
@model ArcaDeMoe.Pages.Mascotas.DeleteModel
@{
    ViewData["Title"] = "Eliminar mascota";
}

@section Styles {
    <link rel="stylesheet" href="~/css/mascotas.css" asp-append-version="true" />
}

<div class="page-header">
    <h1 class="mascotas-icon">Eliminar mascota</h1>
</div>

<div class="card-section">
    <div class="delete-box">
        <p>¿Estás seguro de que deseas eliminar a esta mascota? Esta acción no se puede deshacer.</p>

        <div class="detail-grid" style="margin-bottom:1.25rem">
            <div class="detail-item">
                <label>Nombre</label>
                <span>@Model.Mascota.Nombre</span>
            </div>
            <div class="detail-item">
                <label>Especie / Raza</label>
                <span>@Model.Mascota.Especie — @Model.Mascota.Raza</span>
            </div>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Mascota.Id" />
            <div class="form-actions">
                <button type="submit" class="btn-sm-am btn-delete">Sí, eliminar</button>
                <a asp-page="Index" class="btn-sm-am btn-back">Cancelar</a>
            </div>
        </form>
    </div>
</div>
